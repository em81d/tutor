# Copy this file to server/.env and fill in your real key.
# Get one at https://aistudio.google.com/apikey
#
# This key stays server-side only — it is never sent to the browser.
# The frontend gets a short-lived, single-use token minted by this
# server instead (see /api/live-token in server/index.js).
GEMINI_API_KEY=

# Optional overrides
GEMINI_MODEL=gemini-3.1-flash-live-preview
GEMINI_VOICE=Kore
GEMINI_SYSTEM_INSTRUCTION=You are a friendly, encouraging conversation partner. Keep replies short.

PORT=8787
